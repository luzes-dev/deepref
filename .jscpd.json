{
  "path": [
    "crates",
    "apps/server",
    "services",
    "tools"
  ],
  "format": [
    "rust"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/target/**",
    "**/.git/**",
    "**/.sqlx/**",
    "**/fixtures/**",
    "**/snapshots/**",
    "apps/web/**",
    "docs/**",
    "infra/**",
    "charts/**",
    ".github/**"
  ],
  "reporters": [
    "console",
    "markdown",
    "json"
  ],
  "output": "reports/duplication-rust",
  "no-tips": true
}
