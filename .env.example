APP_ENV=development
# Canonical public origin (scheme + host + port, no path). Development defaults to the web
# dev server; production requires it and it must be https.
# DEEPREF_PUBLIC_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/deepref
API_BIND_ADDR=127.0.0.1:8080
# A non-loopback API_BIND_ADDR refuses to start unless this is set. The API has no
# authentication: set it only when an authenticating proxy is the sole route to the API.
# DEEPREF_ALLOW_NETWORK_BIND=1
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
API_CORS_ALLOW_ANY=false
WORKER_CONCURRENCY=8
WORKER_CLAIM_LEASE_SECS=60
WORKER_RECONCILER_INTERVAL_SECS=30
SHUTDOWN_DEADLINE_SECS=30
RUST_LOG=info
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_ROOT=/tmp/deepref-documents
DOCUMENT_MAX_BYTES=26214400
# Hosted deployments must set DOCUMENT_STORAGE_BACKEND=s3 and all S3 settings.
# DOCUMENT_STORAGE_ENDPOINT=https://s3.example.com
# DOCUMENT_STORAGE_BUCKET=deepref-documents
# DOCUMENT_STORAGE_REGION=sa-east-1
# DOCUMENT_STORAGE_ACCESS_KEY_ID=replace-me
# DOCUMENT_STORAGE_SECRET_ACCESS_KEY=replace-me

# AI provider: OpenCode Go subscription (OpenAI-compatible chat completions).
# Put the real key in .env.local (gitignored), never here.
# Values in the process environment win over .env.local, which wins over .env.
DEEPREF_AI_PROVIDER=opencode-go
OPENCODE_API_KEY=replace-me
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
DEEPREF_AI_DEFAULT_MODEL=glm-5.3-flash
# Soft budget guard: US dollars per million tokens, provider/model=input:output.
# Built-in prices cover glm-5.3-flash, glm-5.3, kimi-k2.6 and deepseek-v4-flash.
# DEEPREF_AI_MODEL_PRICES=opencode-go/glm-5.3=1.40:4.40
# Shared PostgreSQL concurrency ceilings; keep API and worker values identical.
DEEPREF_AI_MAX_CONCURRENT_PER_WORKSPACE=4
DEEPREF_AI_MAX_CONCURRENT_PER_ROUTE=16
# Legacy Z.AI (retired, emergencies only). Needs DEEPREF_AI_PROVIDER=zai.
# ZAI_API_KEY=replace-me
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# Optional GROBID enrichment for parsed PDFs (sections + references).
# Start it with: docker compose --profile enrichment up -d grobid
# GROBID_URL=http://127.0.0.1:8070
# GROBID_TIMEOUT_SECS=120

# Contact address Deepref sends to Crossref, NCBI, Unpaywall, Europe PMC and
# OpenAlex. While it is unset, DOI imports, PubMed imports and open-access
# lookups are refused. Use an address you actually read: some providers reject
# example domains.
DEEPREF_CONTACT_EMAIL=research@example.org

# Metadata providers tried in order per DOI. Set crossref alone to roll back.
# DEEPREF_METADATA_PROVIDERS=openalex,crossref,datacite
# OpenAlex API key. Optional; it only raises the per-second rate limit.
# DEEPREF_OPENALEX_API_KEY=replace-me
# OpenAlex corpus, core or all. Core treats an expansion record as not found; all accepts it.
# DEEPREF_OPENALEX_CORPUS=core

# Authentication provider. All-or-nothing; production needs it once DEEPREF_AUTH_ENABLED=1.
# Put real values in .env.local, never here.
# DEEPREF_AUTH_ENABLED=false
# WORKOS_CLIENT_ID=replace-me
# WORKOS_API_KEY=replace-me
# WORKOS_COOKIE_PASSWORD=replace-me-with-at-least-32-characters
# WORKOS_WEBHOOK_SECRET=replace-me

# Optional Dodo billing. No live/default catalog and no effect on ordinary
# scientific authorization. Actual seller/product approval is a launch prerequisite.
# DODO_MODE=test_mode
# DODO_BUSINESS_ID=
# DODO_API_KEY=
# DODO_WEBHOOK_KEY=
# DODO_WEBHOOK_KEY_PREVIOUS=
# DODO_OFFERINGS_JSON=[]
# DODO_LIVE_ENABLED=false

# Optional distributed operational-rate acceleration (PostgreSQL still caps every grant).
# Set both fields together. Remote/production endpoints require authenticated TLS.
DEEPREF_VALKEY_URL=
# Deployment-unique namespace; lowercase letters, digits and hyphens, max 64 chars.
DEEPREF_VALKEY_NAMESPACE=
# Per connection/command budget, 10..500 ms; omit to use 100 ms.
# DEEPREF_VALKEY_TIMEOUT_MS=100
# Target durable delivery transport; postgres remains the rollout rollback mode.
# WORK_TRANSPORT=jetstream
# NATS_URL=nats://127.0.0.1:4222
# Production requires tls://, NATS_TOKEN from a secret source, and >=3 replicas.
# NATS_STREAM=DEEPREF_WORK
# NATS_SUBJECT_PREFIX=deepref
# NATS_REPLICAS=1
# NATS_MAX_BYTES=1073741824
# NATS_MAX_AGE_SECS=604800
# NATS_ACK_WAIT_SECS=60
# NATS_REQUEST_TIMEOUT_SECS=5
# NATS_REPAIR_AFTER_SECS=900
