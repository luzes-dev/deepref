{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepref.dev/schemas/release-manifest.schema.json",
  "title": "DeepRef immutable release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "chart", "images", "migration_version", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "source": { "$ref": "#/$defs/source" },
    "chart": { "$ref": "#/$defs/chart" },
    "images": { "$ref": "#/$defs/images" },
    "migration_version": { "type": "string", "pattern": "^[0-9]{4,}$" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "git_object": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "repository": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:/-]+$",
      "not": { "pattern": "@|\\s|:latest$" }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": { "$ref": "#/$defs/git_object" },
        "tree": { "$ref": "#/$defs/git_object" }
      }
    },
    "referrer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "mediaType", "artifactType"],
      "properties": {
        "digest": { "$ref": "#/$defs/digest" },
        "mediaType": { "type": "string", "minLength": 1 },
        "artifactType": { "type": ["string", "null"] }
      }
    },
    "referrers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/referrer" }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "referrers"],
      "properties": {
        "repository": { "$ref": "#/$defs/repository" },
        "digest": { "$ref": "#/$defs/digest" },
        "referrers": { "$ref": "#/$defs/referrers" }
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "version", "digest", "referrers"],
      "properties": {
        "repository": { "$ref": "#/$defs/repository" },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "referrers": { "$ref": "#/$defs/referrers" }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "worker", "projector", "web"],
      "properties": {
        "api": { "$ref": "#/$defs/artifact" },
        "worker": { "$ref": "#/$defs/artifact" },
        "projector": { "$ref": "#/$defs/artifact" },
        "web": { "$ref": "#/$defs/artifact" }
      }
    }
  }
}
