# Copy only to a secure, ignored local path or provide these values through CI.
# Never commit a real terraform.tfvars file.
expected_account_id = "333333333333"

kms_administrator_principal_arns = [
  "arn:aws:iam::333333333333:role/REPLACE_WITH_KMS_ADMIN_ROLE",
]

eks_access_entries = {
  platform_admin = {
    principal_arn = "arn:aws:iam::333333333333:role/REPLACE_WITH_EKS_ADMIN_ROLE"
    access_policy_arns = [
      "arn:aws:eks::aws:cluster-access-policy/AmazonEKSClusterAdminPolicy",
    ]
  }
}

# The staging repository policies must grant the resulting role read access.
promotion_trusted_principal_arns = []
promotion_oidc_provider_arn = "arn:aws:iam::333333333333:oidc-provider/token.actions.githubusercontent.com"
promotion_oidc_subjects = [
  "repo:REPLACE_WITH_ORG/ambient-scribes:environment:production-promotion",
]
promotion_source_repository_arns = [
  "arn:aws:ecr:sa-east-1:222222222222:repository/ambient-scribes/REPLACE_WITH_REPOSITORY",
]

secret_reader_principal_arns   = {}
repository_pull_principal_arns = []

tags = {
  CostCenter = "REPLACE_WITH_COST_CENTER"
  Owner      = "REPLACE_WITH_OWNER"
}
