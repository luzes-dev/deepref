{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	log {
		output stdout
		format json
	}

	header {
		-Server
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	encode zstd gzip

	@health path /healthz
	handle @health {
		respond "ok" 200
	}

	# The API container listens on 0.0.0.0 with DEEPREF_ALLOW_NETWORK_BIND=1 (set in
	# docker/rust-service.Dockerfile) so that this proxy can reach it. Neither this
	# proxy nor the API authenticates anyone: put an authenticating proxy in front of
	# this site before exposing it beyond a trusted machine.
	@api path /api /api/*
	handle @api {
		uri strip_prefix /api
		reverse_proxy {$DEEPREF_API_UPSTREAM:deepref-api:8080}
	}

	handle {
		root * /usr/share/caddy
		try_files {path} /200.html
		file_server
	}
}
