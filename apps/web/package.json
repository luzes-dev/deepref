{
	"name": "@deepref/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"generate:client": "orval --config ./orval.config.ts && prettier --write src/lib/api/generated",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@tanstack/svelte-query": "^6.1.45",
		"@tanstack/svelte-virtual": "^3.13.12",
		"@tanstack/table-core": "^8.21.3",
		"pdfjs-dist": "^6.2.108"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fast-check/vitest": "0.4.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.21.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/eslint-plugin-query": "^5.102.4",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24.13.2",
		"@vitest/coverage-v8": "4.1.11",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"fast-check": "4.9.0",
		"globals": "^17.6.0",
		"graphology": "^0.26.0",
		"graphology-layout-forceatlas2": "^0.10.1",
		"graphology-layout-noverlap": "^0.4.2",
		"jsdom": "^30.0.1",
		"jsrepo": "^3.8.1",
		"mode-watcher": "^1.1.0",
		"msw": "^2.15.0",
		"orval": "8.26.0",
		"paneforge": "^1.0.2",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"runed": "^0.37.1",
		"shadcn-svelte": "^1.6.0",
		"sigma": "^3.0.3",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.1.1",
		"svelte-toolbelt": "^0.10.6",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.1",
		"vaul-svelte": "1.0.0-next.7",
