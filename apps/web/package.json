{
	"name": "@deepref/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"generate:client": "orval --config ./orval.config.ts && prettier --write src/lib/api/generated",
		"lint": "prettier --check --cache --cache-strategy content --cache-location .cache/prettier . && eslint --cache --cache-strategy content --cache-location .cache/eslint .",
		"format": "prettier --write --cache --cache-strategy content --cache-location .cache/prettier .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run",
		"test:coverage": "vitest run --coverage",
		"test:mutation": "stryker run",
		"test:mutation:dry-run": "stryker run --dryRunOnly",
		"test:e2e": "playwright test --project=e2e && pnpm run test:visual",
		"test:visual": "playwright test --config=playwright.visual.config.ts",
		"test:visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots"
	},
	"dependencies": {
		"@deepref/ui": "workspace:*",
		"@tanstack/svelte-form": "^1.33.5",
		"@tanstack/svelte-query": "^6.3.1",
		"@tanstack/svelte-virtual": "^3.13.39",
		"@tanstack/svelte-table": "^9.2.8",
		"markdown-it": "^15.0.2",
		"pdfjs-dist": "^6.4.299",
		"sass": "^1.105.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@fast-check/vitest": "0.5.0",
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@fontsource-variable/source-serif-4": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.53.0",
		"@playwright/test": "^1.64.0",
		"@shadcn/lint": "^0.2.0",
		"@stryker-mutator/core": "10.0.0",
		"@stryker-mutator/vitest-runner": "10.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/eslint-plugin-query": "^5.104.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.6.4",
		"@vitest/coverage-v8": "5.0.3",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"fast-check": "4.10.2",
		"globals": "^17.13.0",
		"graphology": "^0.26.0",
		"graphology-layout-forceatlas2": "^0.10.1",
		"graphology-layout-noverlap": "^0.4.2",
		"jsdom": "^30.1.2",
		"jsrepo": "^3.8.1",
		"mode-watcher": "^1.1.0",
		"msw": "^3.0.2",
		"orval": "8.41.0",
		"paneforge": "^1.0.2",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"runed": "^0.37.1",
		"shadcn-svelte": "^1.7.0",
		"sigma": "^3.0.3",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"svelte-toolbelt": "^0.10.6",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
