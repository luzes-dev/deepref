{
  "annotations": {"list": []}, "editable": false, "graphTooltip": 1,
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Available workload replicas", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "kube_deployment_status_replicas_available{namespace=\"deepref\",environment=~\"$environment\"}", "legendFormat": "{{deployment}}"}], "fieldConfig": {"defaults": {}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 2, "type": "timeseries", "title": "Pod restarts", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"deepref\",environment=~\"$environment\"}[1h]))", "legendFormat": "{{pod}}"}], "fieldConfig": {"defaults": {}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 3, "type": "stat", "title": "Tunnel replicas", "gridPos": {"h": 7, "w": 6, "x": 0, "y": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "sum(kube_deployment_status_replicas_available{namespace=\"deepref\",deployment=\"cloudflared\",environment=~\"$environment\"})"}], "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}}},
    {"id": 4, "type": "timeseries", "title": "Certificate lifetime", "gridPos": {"h": 7, "w": 9, "x": 6, "y": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "probe_ssl_earliest_cert_expiry{job=\"deepref-perimeter\",environment=~\"$environment\"} - time()", "legendFormat": "{{instance}}"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 5, "type": "timeseries", "title": "RDS CPU and connections", "gridPos": {"h": 7, "w": 9, "x": 15, "y": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "aws_rds_cpuutilization_average{environment=~\"$environment\"}", "legendFormat": "CPU %"}, {"refId": "B", "expr": "aws_rds_database_connections_average{environment=~\"$environment\"}", "legendFormat": "connections"}], "fieldConfig": {"defaults": {}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 6, "type": "timeseries", "title": "RDS free storage", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "aws_rds_free_storage_space_average{environment=~\"$environment\"}", "legendFormat": "{{db_instance_identifier}}"}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 7, "type": "timeseries", "title": "Budget ratios", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "deepref_aws_budget_actual_ratio{environment=~\"$environment\"}", "legendFormat": "AWS actual"}, {"refId": "B", "expr": "deepref_aws_budget_forecast_ratio{environment=~\"$environment\"}", "legendFormat": "AWS forecast"}, {"refId": "C", "expr": "deepref_cloudflare_budget_forecast_ratio{environment=~\"$environment\"}", "legendFormat": "Cloudflare forecast"}], "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}}
  ],
  "refresh": "30s", "schemaVersion": 39, "tags": ["deepref", "kubernetes", "platform"],
  "templating": {"list": [{"name": "datasource", "type": "datasource", "query": "prometheus", "current": {}}, {"name": "environment", "type": "query", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "query": "label_values(deepref_environment_info, environment)", "includeAll": true, "multi": true}]},
  "time": {"from": "now-6h", "to": "now"}, "timezone": "browser", "title": "DeepRef / Platform", "uid": "deepref-platform", "version": 1
