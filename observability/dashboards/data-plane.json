{
  "annotations": {"list": []}, "editable": false, "graphTooltip": 1,
  "panels": [
    {"id": 1, "type": "timeseries", "title": "JetStream messages by stream", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "nats_jetstream_stream_messages{stream=~\"DEEPREF_.*\",environment=~\"$environment\"}", "legendFormat": "{{stream}}"}], "fieldConfig": {"defaults": {}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 2, "type": "timeseries", "title": "Consumer pending", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "nats_jetstream_consumer_num_pending{consumer=~\"deepref-(worker|projector)\",environment=~\"$environment\"}", "legendFormat": "{{consumer}}"}], "fieldConfig": {"defaults": {}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 3, "type": "stat", "title": "DLQ depth", "gridPos": {"h": 7, "w": 6, "x": 0, "y": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "sum(nats_jetstream_stream_messages{stream=\"DEEPREF_DLQ\",environment=~\"$environment\"})"}], "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}}},
    {"id": 4, "type": "timeseries", "title": "Delivery retries and NAKs", "gridPos": {"h": 7, "w": 9, "x": 6, "y": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "sum(rate(deepref_worker_delivery_retries_total{environment=~\"$environment\"}[5m]))", "legendFormat": "retries"}, {"refId": "B", "expr": "sum(rate(deepref_worker_delivery_naks_total{environment=~\"$environment\"}[5m]))", "legendFormat": "NAKs"}], "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 5, "type": "timeseries", "title": "Lease claims and recoveries", "gridPos": {"h": 7, "w": 9, "x": 15, "y": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "sum(rate(deepref_worker_lease_claims_total{environment=~\"$environment\"}[5m]))", "legendFormat": "claims"}, {"refId": "B", "expr": "sum(rate(deepref_worker_lease_recoveries_total{environment=~\"$environment\"}[5m]))", "legendFormat": "recoveries"}], "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 6, "type": "timeseries", "title": "Outbox pending and exhausted", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "deepref_outbox_pending{environment=~\"$environment\"}", "legendFormat": "pending"}, {"refId": "B", "expr": "deepref_outbox_exhausted{environment=~\"$environment\"}", "legendFormat": "exhausted"}], "fieldConfig": {"defaults": {}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 7, "type": "timeseries", "title": "Provider permit wait and processing duration", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(deepref_provider_permit_wait_seconds_bucket{environment=~\"$environment\"}[5m])))", "legendFormat": "permit wait p95"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(deepref_worker_processing_duration_seconds_bucket{environment=~\"$environment\"}[5m])))", "legendFormat": "processing p95"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}}
  ],
  "refresh": "30s", "schemaVersion": 39, "tags": ["deepref", "nats", "worker"],
  "templating": {"list": [{"name": "datasource", "type": "datasource", "query": "prometheus", "current": {}}, {"name": "environment", "type": "query", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "query": "label_values(deepref_environment_info, environment)", "includeAll": true, "multi": true}]},
