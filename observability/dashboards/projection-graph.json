{
  "annotations": {"list": []}, "editable": false, "graphTooltip": 1,
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Projection lag", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "deepref_projection_lag_seconds{environment=~\"$environment\"}", "legendFormat": "{{project_id}}"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 2, "type": "timeseries", "title": "Projection throughput and failures", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "sum(rate(deepref_projection_events_total{environment=~\"$environment\",result=\"success\"}[5m]))", "legendFormat": "success"}, {"refId": "B", "expr": "sum(rate(deepref_projection_failures_total{environment=~\"$environment\"}[5m]))", "legendFormat": "failures"}], "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 3, "type": "stat", "title": "Neo4j available", "gridPos": {"h": 7, "w": 6, "x": 0, "y": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "max(up{job=\"neo4j\",environment=~\"$environment\"})"}], "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}}},
    {"id": 4, "type": "timeseries", "title": "Rebuild elapsed and progress", "gridPos": {"h": 7, "w": 9, "x": 6, "y": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "deepref_projection_rebuild_elapsed_seconds{environment=~\"$environment\"}", "legendFormat": "elapsed"}, {"refId": "B", "expr": "deepref_projection_rebuild_progress_ratio{environment=~\"$environment\"}", "legendFormat": "progress"}], "fieldConfig": {"defaults": {}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 5, "type": "timeseries", "title": "Entity revisions applied", "gridPos": {"h": 7, "w": 9, "x": 15, "y": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "max by (entity_type) (deepref_projection_revision{environment=~\"$environment\"})", "legendFormat": "{{entity_type}}"}], "fieldConfig": {"defaults": {}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 6, "type": "timeseries", "title": "Graph route 5xx responses", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "sum by (route) (rate(deepref_http_requests_total{service=\"api\",environment=~\"$environment\",route=~\".*(graph|recommendations).*\",status=~\"5..\"}[5m]))", "legendFormat": "{{route}}"}], "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 7, "type": "timeseries", "title": "Metric snapshot age", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "deepref_metric_snapshot_age_seconds{environment=~\"$environment\"}", "legendFormat": "{{project_id}}"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}}
  ],
  "refresh": "30s", "schemaVersion": 39, "tags": ["deepref", "projector", "neo4j"],
  "templating": {"list": [{"name": "datasource", "type": "datasource", "query": "prometheus", "current": {}}, {"name": "environment", "type": "query", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "query": "label_values(deepref_environment_info, environment)", "includeAll": true, "multi": true}]},
  "time": {"from": "now-6h", "to": "now"}, "timezone": "browser", "title": "DeepRef / Projection and Graph", "uid": "deepref-projection-graph", "version": 1
}
