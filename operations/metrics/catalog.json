      "delivery_test_id": "local-queue-age-v1",
      "thresholds_approved": false,
      "freshness": "db_snapshot",
      "source_gap": "",
      "capture_policy": {
        "complete": "deepref.worker.metrics.sample.up",
        "observed_at": "deepref.worker.metrics.last_success",
        "timestamp_source": "gauge_value"
      }
    },
    {
