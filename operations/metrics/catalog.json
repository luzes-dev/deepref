{
  "schema_version": 1,
  "status": "local_proposals_unapproved",
  "production_activation_permitted": false,
  "rules": [
    {
      "id": "api-availability",
      "title": "Response-start non-5xx ratio",
      "source_kind": "backend_query",
      "instruments": ["deepref.http.requests"],
      "unit": "ratio",
      "dimensions": {},
      "replica_reducer": "sum_rates",
      "max_age_seconds": 60,
      "ticket": 0.999,
      "page": 0.995,
      "comparison": "below",
      "window_seconds": 300,
      "owner_role": "api-owner",
      "runbook": "docs/metrics-and-alerts-runbook.md#alert-acceptance-still-required",
      "delivery_test_id": "local-api-availability-v1",
      "thresholds_approved": false,
      "freshness": "query_capture",
      "source_gap": "Verified cumulative-counter query and external end-user probe required",
      "capture_policy": {
        "complete": "verified_query_receipt",
        "observed_at": "source_window_end",
        "timestamp_source": "verified_query_binding"
      }
    },
    {
      "id": "api-latency",
      "title": "Non-SSE response-header p95",
      "source_kind": "backend_query",
      "instruments": ["deepref.http.response_header.duration"],
      "unit": "seconds",
      "dimensions": {
        "route_class": "*"
      },
      "replica_reducer": "sum_histogram_buckets",
      "max_age_seconds": 60,
      "ticket": 0.75,
      "page": 2,
      "comparison": "above",
      "window_seconds": 300,
      "owner_role": "api-owner",
      "runbook": "docs/metrics-and-alerts-runbook.md#alert-acceptance-still-required",
      "delivery_test_id": "local-api-latency-v1",
      "thresholds_approved": false,
      "freshness": "query_capture",
      "source_gap": "Verified histogram query required; no single sample is a p95",
      "capture_policy": {
        "complete": "verified_query_receipt",
        "observed_at": "source_window_end",
        "timestamp_source": "verified_query_binding"
      }
    },
    {
      "id": "schema-behind",
      "title": "Replica schema behind",
      "source_kind": "backend_query",
      "instruments": ["deepref.schema.behind"],
      "unit": "boolean",
      "dimensions": {},
      "replica_reducer": "max",
      "max_age_seconds": 60,
      "ticket": 0,
      "page": 0,
      "comparison": "above",
      "window_seconds": 300,
      "owner_role": "api-owner",
      "runbook": "docs/release-and-migration-runbook.md#3-replica-schema-mismatch-during-rollout",
      "delivery_test_id": "local-schema-behind-v1",
      "thresholds_approved": false,
      "freshness": "query_capture",
      "source_gap": "Readiness probe success/capture binding required",
      "capture_policy": {
        "complete": "verified_query_receipt",
        "observed_at": "source_window_end",
        "timestamp_source": "verified_query_binding"
      }
    },
    {
      "id": "queue-age",
      "title": "Oldest due job age",
      "source_kind": "global_gauge",
      "instruments": ["deepref.worker.queue.oldest_due.age"],
      "unit": "seconds",
      "dimensions": {
        "pool": "*"
      },
      "replica_reducer": "max",
      "max_age_seconds": 90,
      "ticket": 60,
      "page": 300,
      "comparison": "above",
      "window_seconds": 300,
      "owner_role": "worker-owner",
