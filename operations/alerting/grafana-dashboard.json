{
  "title": "DeepRef operations (proposed)",
  "uid": "deepref-operations",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "tags": [
    "deepref",
    "proposed"
  ],
  "description": "Proposed SLO dashboard. Gauges sampled from PostgreSQL are global: reduce with max, never sum. Thresholds are unapproved (handoff 12).",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus-compatible source"
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "API non-5xx ratio",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(deepref_http_requests_total{status_class!=\"5xx\"}[5m])) / sum(rate(deepref_http_requests_total[5m]))",
          "legendFormat": "ratio"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "API p95 response-header latency by route class",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (route_class, le) (rate(deepref_http_response_header_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route_class}}"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Oldest due job age by pool",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pool) (deepref_worker_queue_oldest_due_age_seconds)",
          "legendFormat": "{{pool}}"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Queue depth, in flight and capacity by pool",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pool) (deepref_worker_queue_depth)",
          "legendFormat": "depth {{pool}}"
        },
        {
          "refId": "B",
          "expr": "max by (pool) (deepref_worker_in_flight)",
          "legendFormat": "in flight {{pool}}"
        },
        {
          "refId": "C",
          "expr": "max by (pool) (deepref_worker_capacity)",
          "legendFormat": "capacity {{pool}}"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Retained dead jobs by pool",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pool) (deepref_worker_dead_depth)",
          "legendFormat": "{{pool}}"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Live workers",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(deepref_worker_live)",
          "legendFormat": "live"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Durable backlog oldest age by family",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (family) (deepref_backlog_oldest_age_seconds)",
          "legendFormat": "{{family}}"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Durable backlog depth by family",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (family) (deepref_backlog_depth)",
          "legendFormat": "{{family}}"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Metric sampler freshness",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(deepref_worker_metrics_last_success_seconds)",
          "legendFormat": "seconds since last complete sample"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "JetStream readiness and pending",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(deepref_transport_ready)",
          "legendFormat": "ready"
        },
        {
          "refId": "B",
          "expr": "max by (pool) (deepref_transport_pending)",
          "legendFormat": "pending {{pool}}"
        }
      ],
      "id": 10
    }
  ]
}
