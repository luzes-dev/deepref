{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["global", "namespace", "images", "serviceAccounts", "runtime", "api", "worker", "web", "migration", "cloudflared", "adot", "externalSecrets", "networkPolicy", "podDisruptionBudgets", "imageVerification"],
  "definitions": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "digestOrEmpty": {"type": "string", "pattern": "^(|sha256:[0-9a-f]{64})$"},
    "repository": {"type": "string", "minLength": 1, "pattern": "^[^@\\s]+$"},
    "repositoryOrEmpty": {"type": "string", "pattern": "^(|[^@\\s]+)$"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {"repository": {"$ref": "#/definitions/repository"}, "digest": {"$ref": "#/definitions/digest"}}
    },
    "applicationImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {"repository": {"$ref": "#/definitions/repositoryOrEmpty"}, "digest": {"$ref": "#/definitions/digestOrEmpty"}}
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"$ref": "#/definitions/resourcePair"},
        "limits": {"$ref": "#/definitions/resourcePair"}
      }
    },
    "resourcePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {"cpu": {"type": "string", "minLength": 1}, "memory": {"type": "string", "minLength": 1}}
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "storageClassName"],
      "properties": {"size": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"}, "storageClassName": {"type": "string", "minLength": 1}}
    },
    "remoteProperty": {"type": "string", "minLength": 1},
    "cidrs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"}}
  },
  "properties": {
    "global": {
      "type": "object", "additionalProperties": false,
      "required": ["environment", "clusterDomain", "imagePullPolicy", "imagePullSecrets", "podLabels"],
      "properties": {
        "environment": {"enum": ["development", "staging", "production"]},
        "clusterDomain": {"type": "string", "minLength": 1},
        "imagePullPolicy": {"enum": ["IfNotPresent", "Always", "Never"]},
        "imagePullSecrets": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "podLabels": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "namespace": {
      "type": "object", "additionalProperties": false, "required": ["create", "name"],
      "properties": {"create": {"type": "boolean"}, "name": {"type": "string"}}
    },
    "images": {
      "type": "object", "additionalProperties": false,
      "required": ["api", "worker", "web", "cloudflared", "adot"],
      "properties": {
        "api": {"$ref": "#/definitions/applicationImage"}, "worker": {"$ref": "#/definitions/applicationImage"},
        "web": {"$ref": "#/definitions/applicationImage"},
        "cloudflared": {"$ref": "#/definitions/image"}, "adot": {"$ref": "#/definitions/image"}
      }
    },
    "serviceAccounts": {
      "type": "object", "additionalProperties": false,
      "required": ["api", "worker", "web", "cloudflared", "adot"],
      "properties": {
        "api": {"type": "string", "const": "deepref-api"}, "worker": {"type": "string", "const": "deepref-worker"},
        "web": {"type": "string", "const": "deepref-web"},
        "cloudflared": {"type": "string", "const": "deepref-cloudflared"},
        "adot": {"type": "string", "const": "deepref-adot"}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false, "required": ["database", "shutdownDeadlineSeconds"],
      "properties": {
        "database": {
          "type": "object", "additionalProperties": false,
          "required": ["poolMin", "poolMax", "acquireTimeoutSeconds", "idleTimeoutSeconds", "maxLifetimeSeconds"],
          "properties": {
            "poolMin": {"type": "integer", "minimum": 0}, "poolMax": {"type": "integer", "minimum": 1},
            "acquireTimeoutSeconds": {"type": "integer", "minimum": 1}, "idleTimeoutSeconds": {"type": "integer", "minimum": 1},
            "maxLifetimeSeconds": {"type": "integer", "minimum": 1}
          }
        },
        "shutdownDeadlineSeconds": {"type": "integer", "minimum": 1}
      }
    },
    "api": {
      "type": "object", "additionalProperties": false, "required": ["replicas", "corsOrigins", "terminationGracePeriodSeconds", "resources"],
      "properties": {"replicas": {"type": "integer", "minimum": 2}, "corsOrigins": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uri"}}, "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1}, "resources": {"$ref": "#/definitions/resources"}}
    },
    "worker": {
      "type": "object", "additionalProperties": false, "required": ["replicas", "concurrency", "claimLeaseSeconds", "reconcilerIntervalSeconds", "terminationGracePeriodSeconds", "resources"],
      "properties": {"replicas": {"type": "integer", "minimum": 1}, "concurrency": {"type": "integer", "minimum": 1}, "claimLeaseSeconds": {"type": "integer", "minimum": 1}, "reconcilerIntervalSeconds": {"type": "integer", "minimum": 1}, "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1}, "resources": {"$ref": "#/definitions/resources"}}
    },
    "web": {
      "type": "object", "additionalProperties": false, "required": ["replicas", "terminationGracePeriodSeconds", "resources"],
      "properties": {"replicas": {"type": "integer", "minimum": 2}, "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1}, "resources": {"$ref": "#/definitions/resources"}}
    },
    "migration": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "activeDeadlineSeconds", "backoffLimit", "resources"],
      "properties": {"enabled": {"type": "boolean"}, "activeDeadlineSeconds": {"type": "integer", "minimum": 1}, "backoffLimit": {"type": "integer", "minimum": 0, "maximum": 1}, "resources": {"$ref": "#/definitions/resources"}}
    },
    "cloudflared": {
      "type": "object", "additionalProperties": false, "required": ["replicas", "terminationGracePeriodSeconds", "resources"],
      "properties": {"replicas": {"type": "integer", "enum": [1, 2]}, "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1}, "resources": {"$ref": "#/definitions/resources"}}
    },
    "adot": {
      "type": "object", "additionalProperties": false, "required": ["replicas", "awsRegion", "prometheusRemoteWriteEndpoint", "terminationGracePeriodSeconds", "resources"],
      "properties": {"replicas": {"type": "integer", "minimum": 1}, "awsRegion": {"type": "string", "minLength": 1}, "prometheusRemoteWriteEndpoint": {"type": "string"}, "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1}, "resources": {"$ref": "#/definitions/resources"}}
    },
    "externalSecrets": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "refreshInterval", "secretStoreRef", "remote"],
      "properties": {
        "enabled": {"type": "boolean"}, "refreshInterval": {"type": "string", "pattern": "^[1-9][0-9]*(s|m|h)$"},
        "secretStoreRef": {"type": "object", "additionalProperties": false, "required": ["name", "kind"], "properties": {"name": {"type": "string", "minLength": 1}, "kind": {"enum": ["SecretStore", "ClusterSecretStore"]}}},
        "remote": {
          "type": "object", "additionalProperties": false, "required": ["database", "cloudflared"],
          "properties": {
            "database": {"type": "object", "additionalProperties": false, "required": ["key", "urlProperty"], "properties": {"key": {"$ref": "#/definitions/remoteProperty"}, "urlProperty": {"$ref": "#/definitions/remoteProperty"}}},
            "cloudflared": {"type": "object", "additionalProperties": false, "required": ["key", "tokenProperty"], "properties": {"key": {"$ref": "#/definitions/remoteProperty"}, "tokenProperty": {"$ref": "#/definitions/remoteProperty"}}}
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "databaseEgress", "telemetryEgress", "cloudflareEgress"],
      "properties": {
        "enabled": {"type": "boolean"},
        "databaseEgress": {"type": "object", "additionalProperties": false, "required": ["cidrs", "port"], "properties": {"cidrs": {"$ref": "#/definitions/cidrs"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}},
        "telemetryEgress": {"type": "object", "additionalProperties": false, "required": ["cidrs", "ports"], "properties": {"cidrs": {"$ref": "#/definitions/cidrs"}, "ports": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 65535}, "uniqueItems": true}}},
        "cloudflareEgress": {"type": "object", "additionalProperties": false, "required": ["cidrs", "ports"], "properties": {"cidrs": {"$ref": "#/definitions/cidrs"}, "ports": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 65535}, "uniqueItems": true}}}
      }
    },
    "podDisruptionBudgets": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}},
    "imageVerification": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "validationFailureAction", "repositoryPatterns", "keyless"],
      "properties": {
        "enabled": {"type": "boolean"}, "validationFailureAction": {"enum": ["Audit", "Enforce"]},
        "repositoryPatterns": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "keyless": {"type": "object", "additionalProperties": false, "required": ["issuer", "subject"], "properties": {"issuer": {"type": "string", "format": "uri"}, "subject": {"type": "string"}}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"global": {"properties": {"environment": {"enum": ["staging", "production"]}}}}},
      "then": {"properties": {"cloudflared": {"properties": {"replicas": {"const": 2}}}}}
    },
    {
      "if": {"properties": {"global": {"properties": {"environment": {"const": "production"}}}}},
      "then": {
        "properties": {
          "imageVerification": {
            "properties": {
              "enabled": {"const": true},
              "validationFailureAction": {"const": "Enforce"},
              "repositoryPatterns": {"minItems": 1},
              "keyless": {"properties": {"subject": {"minLength": 1}}}
            }
          },
          "api": {"properties": {"corsOrigins": {"minItems": 1}}},
          "networkPolicy": {
            "properties": {
              "databaseEgress": {"properties": {"cidrs": {"minItems": 1}}},
              "telemetryEgress": {"properties": {"cidrs": {"minItems": 1}}},
              "cloudflareEgress": {"properties": {"cidrs": {"minItems": 1}}}
            }
          }
        }
      }
    }
  ]
}
