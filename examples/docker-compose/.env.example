POSTGRES_USER=deepref
POSTGRES_PASSWORD=deepref
POSTGRES_DB=deepref

# Host ports. Container-to-container ports remain fixed; change these when a
# host port is already in use by another service.
POSTGRES_HOST_PORT=5432
NATS_HOST_PORT=4222
NATS_MONITOR_HOST_PORT=8222
NEO4J_HTTP_HOST_PORT=7474
NEO4J_BOLT_HOST_PORT=7687
API_HOST_PORT=8080
WEB_HOST_PORT=3000

NEO4J_AUTH=neo4j/deepref

# Comma-separated browser origins allowed to call the API.
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Local testing escape hatch. Set to true only when host/port changes make the
# allowlist inconvenient. Do not use this for a public deployment.
API_CORS_ALLOW_ANY=false

RUST_LOG=info
