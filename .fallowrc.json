{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignoreUnresolvedImports": ["/env.js"],
  "ignorePatterns": [
    "apps/web/jsrepo.config.ts",
    "apps/web/static/env.js",
    "apps/web/src/lib/index.ts",
    "apps/web/src/lib/hooks/**/**",
    "apps/web/src/**/*.e2e.ts",
    "apps/web/src/routes/demo/**",
    "apps/web/src/lib/actions/typewriter.svelte.ts",
    "apps/web/src/lib/components/LoadingButton.svelte",
    "apps/web/src/lib/typewriter.svelte.ts",
    "apps/web/src/lib/components/ui/**/**",
    "apps/web/src/lib/api/generated/**/**"
  ],
  "duplicates": {
    "minLines": 15
  },
  "health": {
    "ignore": ["apps/web/src/**/*.svelte"],
    "thresholdOverrides": [
      {
        "files": ["apps/web/src/lib/api/client.ts"],
        "maxCrap": 50,
        "reason": "Small API wrapper; risk is covered by route type checking and fetch error handling."
      }
    ]
  },
  "ignoreDependencies": [
    "@internationalized/date",
    "bits-ui",
    "jsrepo",
    "paneforge",
    "svelte-sonner",
    "svelte-toolbelt",
    "tailwind-variants",
    "vaul-svelte"
  ]
}
